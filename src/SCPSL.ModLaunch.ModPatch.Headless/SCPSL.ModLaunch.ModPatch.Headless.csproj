  <ItemGroup>
    <ProjectReference Include="../SCPSL.ModLaunch.Core/SCPSL.ModLaunch.Core.csproj" />
    <InternalsVisibleTo Include="SCPSL.ModLaunch.Tests" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="../../vendor/ModPatch/*.txt" Link="ThirdParty/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
